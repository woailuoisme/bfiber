# ── 应用基础 ─────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_PORT=3331
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost:3331
ENABLE_DOCS=true
CORS_ALLOWED_ORIGINS=*

# ── 结构化日志 (12-Factor：直写 stdout，生产建议 json，本地建议 console) ───────
LOG_CHANNEL=console
LOG_LEVEL=info

# ── 数据库 (PostgreSQL 18+) ─────────────────────────────────────────────
DB_URL=postgres://postgres:your_password@127.0.0.1:5432/bfiber?sslmode=disable

# ── 缓存 / Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://:your_password@127.0.0.1:6379/0

# ── 请求速率限制 (Sliding Window Throttle，压测或免限流可置为 false) ────────
RATELIMIT_ENABLED=true
RATELIMIT_ANONYMOUS=60
RATELIMIT_AUTHENTICATED=300
RATELIMIT_SENSITIVE=10

# ── 邮件外发服务 (Mail: mailpit / resend / log / null) ─────────────────────
MAIL_ENABLED=true
MAIL_DRIVER=mailpit
MAIL_FROM_ADDRESS=no-reply@bfiber.local
MAIL_FROM_NAME=bfiber
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
# RESEND_API_KEY=re_xxxxxx

# ── 对象存储 (Garage S3 / MinIO) ─────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ENDPOINT=127.0.0.1:3900
AWS_BUCKET=bfiber
AWS_DEFAULT_REGION=garage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_USE_SSL=false

# ── 图像动态处理 (Imgproxy) ──────────────────────────────────────────────
IMGPROXY_ENABLED=true
IMGPROXY_URL=http://127.0.0.1:8088
IMGPROXY_KEY=your_imgproxy_key
IMGPROXY_SALT=your_imgproxy_salt

# ── 全文检索 (Scout / Meilisearch) ──────────────────────────────────────
SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=bfiber_
MEILISEARCH_KEY=your_meilisearch_master_key

# ── 认证与鉴权 ──────────────────────────────────────────────────────────
# JWT 签名密钥 (至少 32 字符，可运行 just jwt-secret 生成)
JWT_SECRET=
SEED_ADMIN_PASSWORD=admin12345

# ── 实时通信 (Centrifugo) ────────────────────────────────────────────────
CENTRIFUGO_ENABLED=true
CENTRIFUGO_URL=http://127.0.0.1:48000/api
CENTRIFUGO_API_KEY=your_centrifugo_api_key
CENTRIFUGO_SECRET=your_centrifugo_secret

# ── 遥测与全链路监控 (OpenTelemetry -> Collector -> OpenObserve) ─────────────
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# 链路追踪头采样率 (0.0~1.0)：开发测试建议 1.0 (全采)；生产高并发推荐 0.05~0.1 (5%~10% 采样)；超高并发推荐 0.01
# OTEL_TRACES_SAMPLE_RATIO=1.0

# ── 分布式持久化工作流 (Temporal) ──────────────────────────────────────
TEMPORAL_ENABLED=false
TEMPORAL_HOST_PORT=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=bfiber-tasks




// List{{ .PluralPascal }}AndCount 按条件分页查询记录并返回总数（优先从上下文感知活跃事务）。
// 取页与计数由 ScanAndCount 在同一规格上一次完成：Bun 会把 ORDER BY 与 LIMIT/OFFSET 从计数查询中剔除，
// 因此 total 是全量计数而非页内计数；过滤条件只此一处，不会出现列表与计数两份会漂移的谓词。
func List{{ .PluralPascal }}AndCount(
	ctx context.Context,
	db bun.IDB,
	search, status string,
	pagination database.Pagination,
) ([]{{ .PascalName }}, int, error) {
	items := make([]{{ .PascalName }}, 0)
	q := database.ResolveDB(ctx, db).NewSelect().Model(&items)
	if status != "" {
		q = q.Where("{{ .TableAlias }}.status = ?", status)
	}
	if search != "" {
		pattern := "%" + database.EscapeLike(strings.TrimSpace(search)) + "%"
{{- if and .HasCustomFields .SearchSQL }}
		q = q.Where("({{ .SearchSQL }})", {{ .SearchArgs }})
{{- else }}
		q = q.Where("{{ .TableAlias }}.name ILIKE ?", pattern)
{{- end }}
	}

	total, err := pagination.Apply(q.Order("{{ .TableAlias }}.created_at DESC")).ScanAndCount(ctx)
	if err != nil {
		return nil, 0, err
	}
	return items, int(total), nil
}

// Insert 将实体插入数据库（自动透传上下文活跃事务）。
func (m *{{ .PascalName }}) Insert(ctx context.Context, db bun.IDB) error {
	_, err := database.ResolveDB(ctx, db).NewInsert().Model(m).Exec(ctx)
	return err
}

// Update 更新实体的指定列（自动透传上下文活跃事务）。
func (m *{{ .PascalName }}) Update(ctx context.Context, db bun.IDB, columns ...string) error {
	q := database.ResolveDB(ctx, db).NewUpdate().Model(m).WherePK()
	if len(columns) > 0 {
		q = q.Column(columns...)
	}
	_, err := q.Exec(ctx)
	return err
}

// SoftDelete 软删除当前记录（自动透传上下文活跃事务；未删除谓词由 Bun 自动附加）。
func (m *{{ .PascalName }}) SoftDelete(ctx context.Context, db bun.IDB) error {
	now := time.Now().UTC()
	res, err := database.ResolveDB(ctx, db).NewUpdate().
		Model((*{{ .PascalName }})(nil)).
		Set("deleted_at = ?", now).
		Set("updated_at = ?", now).
		Where("id = ?", m.ID).
		Exec(ctx)
	if err != nil {
		return err
	}
	affected, err := res.RowsAffected()
	if err != nil {
		return err
	}
	if affected == 0 {
		return sql.ErrNoRows
	}
	m.DeletedAt = &now
	m.UpdatedAt = now
	return nil
}
{{- if .HasVector }}

// SearchSimilar{{ .PluralPascal }} 按向量余弦相似度检索最相近的记录。
func SearchSimilar{{ .PluralPascal }}(
	ctx context.Context,
	db bun.IDB,
	target vector.Vector,
	limit int,
) ([]{{ .PascalName }}, error) {
	if limit <= 0 {
		limit = 10
	}
	items := make([]{{ .PascalName }}, 0, limit)
	actualDB := database.ResolveDB(ctx, db)
	err := Active{{ .PluralPascal }}Query(actualDB).
		OrderExpr("{{ .TableAlias }}.{{ .VectorColName }} <=> ?", target).
		Limit(limit).
		Scan(ctx, &items)
	if err != nil {
		return nil, err
	}
	return items, nil
}
{{- end }}
{{- if .HasGeo }}

// Find{{ .PluralPascal }}Nearby 按空间地理距离查询范围内的记录（按距离由近到远排序）。
func Find{{ .PluralPascal }}Nearby(
	ctx context.Context,
	db bun.IDB,
	center geo.Point,
	radiusMeters float64,
	limit int,
) ([]{{ .PascalName }}, error) {
	if limit <= 0 {
		limit = 20
	}
	items := make([]{{ .PascalName }}, 0, limit)
	actualDB := database.ResolveDB(ctx, db)
	err := Active{{ .PluralPascal }}Query(actualDB).
		Where("ST_DWithin({{ .TableAlias }}.{{ .GeoColName }}, ?, ?)", center, radiusMeters).
		OrderExpr("ST_Distance({{ .TableAlias }}.{{ .GeoColName }}, ?)", center).
		Limit(limit).
		Scan(ctx, &items)
	if err != nil {
		return nil, err
	}
	return items, nil
}


// Find{{ .PluralPascal }}BySubtree 按 ltree 路径查询指定节点及其所有子孙记录。
func Find{{ .PluralPascal }}BySubtree(
	ctx context.Context,
	db bun.IDB,
	rootPath nestedset.Path,
) ([]{{ .PascalName }}, error) {
	items := make([]{{ .PascalName }}, 0)
	actualDB := database.ResolveDB(ctx, db)
	err := Active{{ .PluralPascal }}Query(actualDB).
		Where("{{ .TableAlias }}.{{ .LTreeColName }} <@ ?", rootPath).

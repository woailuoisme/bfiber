}

// List{{ .PluralPascal }}AndCount 按条件分页查询记录并返回总数（优先从上下文感知活跃事务）。
// 取页与计数由 ScanAndCount 在同一规格上一次完成：Bun 会把 ORDER BY 与 LIMIT/OFFSET 从计数查询中剔除，
// 因此 total 是全量计数而非页内计数；过滤条件只此一处，不会出现列表与计数两份会漂移的谓词。
func List{{ .PluralPascal }}AndCount(
	ctx context.Context,
	db bun.IDB,
	search, status string,
	pagination database.Pagination,
) ([]{{ .PascalName }}, int, error) {
	items := make([]{{ .PascalName }}, 0)
	q := database.ResolveDB(ctx, db).NewSelect().Model(&items)
	if status != "" {
		q = q.Where("{{ .TableAlias }}.status = ?", status)
	}
	if search != "" {
		pattern := "%" + database.EscapeLike(strings.TrimSpace(search)) + "%"
		q = q.Where("{{ .TableAlias }}.name ILIKE ?", pattern)
	}

	total, err := pagination.Apply(q.Order("{{ .TableAlias }}.created_at DESC")).ScanAndCount(ctx)
	if err != nil {
		return nil, 0, err
	}
	return items, int(total), nil
}


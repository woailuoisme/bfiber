// Find{{ .PascalName }}ByID 按主键查询记录（优先从上下文感知活跃事务）。
func Find{{ .PascalName }}ByID(ctx context.Context, db bun.IDB, id string) (*{{ .PascalName }}, error) {
	actualDB := database.ResolveDB(ctx, db)
	entity := new({{ .PascalName }})
	if err := Active{{ .PluralPascal }}Query(actualDB).Where("{{ .TableAlias }}.id = ?", id).Scan(ctx, entity); err != nil {

// SoftDelete 软删除当前记录（自动透传上下文活跃事务；未删除谓词由 Bun 自动附加）。
func (m *{{ .PascalName }}) SoftDelete(ctx context.Context, db bun.IDB) error {
	now := time.Now().UTC()
	res, err := database.ResolveDB(ctx, db).NewUpdate().
		Model((*{{ .PascalName }})(nil)).
		Set("deleted_at = ?", now).
		Set("updated_at = ?", now).
		Where("id = ?", m.ID).
		Exec(ctx)
	if err != nil {
		return err
	}
	affected, err := res.RowsAffected()
	if err != nil {
		return err
	}
	if affected == 0 {
		return sql.ErrNoRows
	}
	m.DeletedAt = &now
	m.UpdatedAt = now
	return nil
}

func (s *service) List(ctx context.Context, query List{{ .PascalName }}QueryParams) ([]{{ .PascalName }}Resource, response.Meta, error) {
	pagination := database.Pagination{Page: query.Page, PageSize: query.PageSize}
	entities, total, err := models.List{{ .PluralPascal }}AndCount(ctx, s.db, query.Search, query.Status, pagination)
	if err != nil {
		return nil, response.Meta{}, errs.Internal(err)
	}

	items := lo.Map(entities, func(item models.{{ .PascalName }}, _ int) {{ .PascalName }}Resource {
		return To{{ .PascalName }}Resource(&item)
	})

	// 元信息按同一规格归一后的区间返回，避免越界参数在响应里原样透出。
	page, pageSize := pagination.Normalise()
	return items, response.NewMeta(page, pageSize, total), nil
}

func (s *service) GetByID(ctx context.Context, id string) (*{{ .PascalName }}Resource, error) {
	entity, err := models.Find{{ .PascalName }}ByID(ctx, s.db, id)
	if err != nil {
		return nil, errs.From(err, errs.NotFound("{{ .KebabName }} not found"))
	}

	res := To{{ .PascalName }}Resource(entity)

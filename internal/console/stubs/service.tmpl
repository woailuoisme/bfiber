func (s *service) Create(ctx context.Context, req Create{{ .PascalName }}Body) (*{{ .PascalName }}Resource, error) {
	entity := &models.{{ .PascalName }}{
		Name:        req.Name,
		Description: &req.Description,
		Status:      req.Status,
	}

	if err := entity.Insert(ctx, s.db); err != nil {
		return nil, errs.Internal(err)
	}

	res := To{{ .PascalName }}Resource(entity)
	return &res, nil
}

func (s *service) Update(ctx context.Context, id string, req Update{{ .PascalName }}Body) (*{{ .PascalName }}Resource, error) {
	entity, err := models.Find{{ .PascalName }}ByID(ctx, s.db, id)
	if err != nil {
		return nil, errs.From(err, errs.NotFound("{{ .KebabName }} not found"))
	}

	var changedColumns []string
	if req.Name != nil {
		entity.Name = *req.Name
		changedColumns = append(changedColumns, "name")
	}
	if req.Description != nil {
		entity.Description = req.Description
		changedColumns = append(changedColumns, "description")
	}
	if req.Status != nil {
		entity.Status = *req.Status
		changedColumns = append(changedColumns, "status")
	}

	if len(changedColumns) > 0 {
		if err := entity.Update(ctx, s.db, changedColumns...); err != nil {
			return nil, errs.Internal(err)
		}
	}

	res := To{{ .PascalName }}Resource(entity)
	return &res, nil
}

func (s *service) Delete(ctx context.Context, id string) error {
	entity, err := models.Find{{ .PascalName }}ByID(ctx, s.db, id)
	if err != nil {
		return errs.From(err, errs.NotFound("{{ .KebabName }} not found"))
	}

	if err := entity.SoftDelete(ctx, s.db); err != nil {
		return errs.From(err, errs.NotFound("{{ .KebabName }} not found"))
	}

	return nil
}

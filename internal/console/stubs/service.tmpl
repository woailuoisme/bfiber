package {{ .PackageName }}

import (
	"context"

	"github.com/samber/lo"
	"github.com/uptrace/bun"

	"bfiber/internal/database"
	"bfiber/internal/database/models"
	"bfiber/internal/platform/errs"
{{- if .HasGeo }}
	"bfiber/internal/platform/pgtype/geo"
{{- end }}
{{- if .HasLTree }}
	"bfiber/internal/platform/pgtype/nestedset"
{{- end }}
{{- if .HasVector }}
	"bfiber/internal/platform/pgtype/vector"
{{- end }}
	"bfiber/internal/platform/response"
)

// Service 定义 {{ .ChineseName }} 业务用例契约。
type Service interface {
	List(ctx context.Context, query List{{ .PascalName }}QueryParams) ([]{{ .PascalName }}Resource, response.Meta, error)
	GetByID(ctx context.Context, id string) (*{{ .PascalName }}Resource, error)
	Create(ctx context.Context, req Create{{ .PascalName }}Body) (*{{ .PascalName }}Resource, error)
	Update(ctx context.Context, id string, req Update{{ .PascalName }}Body) (*{{ .PascalName }}Resource, error)
	Delete(ctx context.Context, id string) error
}

type service struct {
	db bun.IDB
}

// NewService 构造 {{ .ChineseName }} 业务服务实例。
func NewService(db bun.IDB) Service {
	return &service{db: db}
}

func (s *service) List(ctx context.Context, query List{{ .PascalName }}QueryParams) ([]{{ .PascalName }}Resource, response.Meta, error) {
	pagination := database.Pagination{Page: query.Page, PageSize: query.PageSize}
	entities, total, err := models.List{{ .PluralPascal }}AndCount(ctx, s.db, query.Search, query.Status, pagination)
	if err != nil {
		return nil, response.Meta{}, errs.Internal(err)
	}

	items := lo.Map(entities, func(item models.{{ .PascalName }}, _ int) {{ .PascalName }}Resource {
		return To{{ .PascalName }}Resource(&item)
	})

	// 元信息按同一规格归一后的区间返回，避免越界参数在响应里原样透出。
	page, pageSize := pagination.Normalise()
	return items, response.NewMeta(page, pageSize, total), nil
}

func (s *service) GetByID(ctx context.Context, id string) (*{{ .PascalName }}Resource, error) {
	entity, err := models.Find{{ .PascalName }}ByID(ctx, s.db, id)
	if err != nil {
		return nil, errs.From(err, errs.NotFound("{{ .KebabName }} not found"))
	}

	res := To{{ .PascalName }}Resource(entity)
	return &res, nil
}

func (s *service) Create(ctx context.Context, req Create{{ .PascalName }}Body) (*{{ .PascalName }}Resource, error) {
{{- if .HasSKU }}
	// 校验货号唯一性（业务前置防线）
	if existing, _ := models.Find{{ .PascalName }}BySKU(ctx, s.db, req.SKU); existing != nil {
		return nil, errs.Conflict("SKU already exists")
	}
{{- end }}
	entity := &models.{{ .PascalName }}{
{{- if .HasCustomFields }}
{{- range .CustomFields }}
{{- if .IsVector }}
		{{ .PascalName }}: vector.NewVector(req.{{ .PascalName }}),
{{- else if .IsLTree }}
		{{ .PascalName }}: nestedset.Path(req.{{ .PascalName }}),
{{- else if and .IsGeo (not .IsNullable) }}
		{{ .PascalName }}: lo.FromPtr(req.{{ .PascalName }}),
{{- else }}
		{{ .PascalName }}: req.{{ .PascalName }},
{{- end }}
{{- end }}
{{- else }}
		Name:        req.Name,
		Description: &req.Description,
		Status:      req.Status,
{{- end }}
	}

	if err := entity.Insert(ctx, s.db); err != nil {
		return nil, errs.Internal(err)
	}

	res := To{{ .PascalName }}Resource(entity)
	return &res, nil
}

func (s *service) Update(ctx context.Context, id string, req Update{{ .PascalName }}Body) (*{{ .PascalName }}Resource, error) {
	entity, err := models.Find{{ .PascalName }}ByID(ctx, s.db, id)
	if err != nil {
		return nil, errs.From(err, errs.NotFound("{{ .KebabName }} not found"))
	}

{{- if .HasSKU }}
	if req.SKU != nil && *req.SKU != entity.SKU {
		if existing, _ := models.Find{{ .PascalName }}BySKU(ctx, s.db, *req.SKU); existing != nil && existing.ID != entity.ID {
			return nil, errs.Conflict("SKU already exists")
		}
	}
{{- end }}

	changedColumns := apply{{ .PascalName }}Patch(entity, &req)
	if len(changedColumns) > 0 {
		if err := entity.Update(ctx, s.db, changedColumns...); err != nil {
			return nil, errs.Internal(err)
		}
	}

	res := To{{ .PascalName }}Resource(entity)
	return &res, nil
}

// apply{{ .PascalName }}Patch 局部更新实体字段并收集变更列名。
func apply{{ .PascalName }}Patch(entity *models.{{ .PascalName }}, req *Update{{ .PascalName }}Body) []string {
	var changedColumns []string
{{- if .HasCustomFields }}
{{- range .CustomFields }}
{{- if .IsVector }}
	if req.{{ .PascalName }} != nil {
		entity.{{ .PascalName }} = vector.NewVector(req.{{ .PascalName }})
		changedColumns = append(changedColumns, "{{ .ColName }}")
	}
{{- else if .IsLTree }}
	if req.{{ .PascalName }} != nil {
		entity.{{ .PascalName }} = nestedset.Path(*req.{{ .PascalName }})
		changedColumns = append(changedColumns, "{{ .ColName }}")
	}
{{- else if and .IsGeo (not .IsNullable) }}
	if req.{{ .PascalName }} != nil {
		entity.{{ .PascalName }} = *req.{{ .PascalName }}
		changedColumns = append(changedColumns, "{{ .ColName }}")
	}
{{- else if .IsComplexType }}
	if req.{{ .PascalName }} != nil {
		entity.{{ .PascalName }} = req.{{ .PascalName }}
		changedColumns = append(changedColumns, "{{ .ColName }}")
	}
{{- else if .IsNullable }}
	if req.{{ .PascalName }} != nil {
		entity.{{ .PascalName }} = req.{{ .PascalName }}
		changedColumns = append(changedColumns, "{{ .ColName }}")
	}
{{- else }}
	if req.{{ .PascalName }} != nil {
		entity.{{ .PascalName }} = *req.{{ .PascalName }}
		changedColumns = append(changedColumns, "{{ .ColName }}")
	}
{{- end }}
{{- end }}
{{- else }}
	if req.Name != nil {
		entity.Name = *req.Name
		changedColumns = append(changedColumns, "name")
	}
	if req.Description != nil {
		entity.Description = req.Description
		changedColumns = append(changedColumns, "description")
	}
	if req.Status != nil {
		entity.Status = *req.Status
		changedColumns = append(changedColumns, "status")
	}
{{- end }}
	return changedColumns
}

func (s *service) Delete(ctx context.Context, id string) error {
	entity, err := models.Find{{ .PascalName }}ByID(ctx, s.db, id)
	if err != nil {
		return errs.From(err, errs.NotFound("{{ .KebabName }} not found"))
	}

	if err := entity.SoftDelete(ctx, s.db); err != nil {
		return errs.From(err, errs.NotFound("{{ .KebabName }} not found"))
	}

	return nil
}

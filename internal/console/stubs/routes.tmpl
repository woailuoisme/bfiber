package {{ .PackageName }}

import (
	"github.com/gofiber/fiber/v3"

	"bfiber/internal/middleware"
	"bfiber/internal/platform/authorization"
)

{{ if .IsAdmin }}
// RegisterAdminRoutes 注册管理端点 ({{ .RoutePath }})。
func RegisterAdminRoutes(router fiber.Router, handler *Handler, mw *middleware.Middleware) {
	group := router.Group("{{ .RoutePath }}", mw.Throttle(middleware.TierAuthenticated), mw.Auth())

	group.Get("", mw.Can(authorization.Resource("{{ .PluralSnake }}"), authorization.ActionList), handler.List)
	group.Post("", mw.Can(authorization.Resource("{{ .PluralSnake }}"), authorization.ActionCreate), handler.Create)
	group.Get("/:id", mw.Can(authorization.Resource("{{ .PluralSnake }}"), authorization.ActionRead), handler.GetByID)
	group.Patch("/:id", mw.Can(authorization.Resource("{{ .PluralSnake }}"), authorization.ActionUpdate), handler.Update)
	group.Delete("/:id", mw.Can(authorization.Resource("{{ .PluralSnake }}"), authorization.ActionDelete), handler.Delete)
}
{{ else }}
// RegisterRoutes 注册业务路由端点 ({{ .RoutePath }})。
func RegisterRoutes(router fiber.Router, handler *Handler, mw *middleware.Middleware) {
	group := router.Group("{{ .RoutePath }}", mw.Throttle(middleware.TierAuthenticated), mw.Auth())

	group.Get("", handler.List)
	group.Post("", handler.Create)
	group.Get("/:id", handler.GetByID)
	group.Patch("/:id", handler.Update)
	group.Delete("/:id", handler.Delete)
}
{{ end }}
